# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Gmail SMTP Configuration
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
RECIPIENT_EMAIL=your-recipient-email@gmail.com

# Instructions:
# 1. Copy this file to .env
# 2. Replace EMAIL_USER with your Gmail address
# 3. Generate an App Password for Gmail:
#    - Go to Google Account settings
#    - Security -> 2-Step Verification -> App passwords
#    - Generate a new app password for "Mail"
#    - Use that password as EMAIL_PASS
# 4. Replace RECIPIENT_EMAIL with where you want to receive messages
